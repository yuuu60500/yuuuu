# Packaged indicator zips are built from MQL5/Indicators/HMI/ on demand and
# sent to the user directly; the source in the tree is the record, not the
# binary. Keeping them out avoids one opaque blob per shipped version.
HMI_v*.zip

# MT5 artefacts, if a compiled build ever lands in the tree
*.ex5

# Test-script output written next to the log file
reload_diff.txt
live_vs_build_diff.txt
poi_rejects.txt

# ReloadTest.ps1 writes these next to the log it read (per source since v2.24),
# including into the synthetic case folders under tools/logtests
reload_diff_*.txt
live_vs_build_diff_*.txt
attribution_*.txt
poi_rejects_*.txt
ctx_events.csv

# Python bytecode from the offline models
__pycache__/
