# Database: SQLite for quick local dev, PostgreSQL for real use
# DATABASE_URL=postgresql+psycopg2://audiosub:audiosub@localhost:5432/audiosub
DATABASE_URL=sqlite:///./data/audiosub.db

# Storage: "local" (dev) or "s3" (AWS S3 / Cloudflare R2)
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=./data/storage
# S3_BUCKET=
# S3_ENDPOINT_URL=https://<account>.r2.cloudflarestorage.com
# S3_REGION=auto
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# FFmpeg binary (defaults to "ffmpeg" on PATH)
FFMPEG_BINARY=ffmpeg

# Speech recognition: faster_whisper (local), openai (Whisper API) or mock
ASR_PROVIDER=faster_whisper
WHISPER_MODEL=large-v3
WHISPER_DEVICE=auto
WHISPER_COMPUTE_TYPE=default
# OPENAI_API_KEY=

# Translation: claude or mock
TRANSLATION_PROVIDER=claude
ANTHROPIC_API_KEY=
TRANSLATION_MODEL=claude-opus-5
TRANSLATION_BATCH_SIZE=15
TRANSLATION_CONTEXT_SIZE=3

CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=2048
